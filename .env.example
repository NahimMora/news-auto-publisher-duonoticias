DUO_BASE_URL=http://localhost:3000
DUO_ADMIN_KEY=dev-admin-key

# Paparazzi scraper
PAPARAZZI_BASE_URL=https://www.paparazzi.com.ar
PAPARAZZI_PER_PAGE=20
PAPARAZZI_MAX_PAGES=5
PAPARAZZI_VIDEO_TIMEOUT=60

# Instagram overlay (optional paths)
IG_TARGET_SIZE=1080,1350
IG_CAPTION_LIMIT=2000
IG_WATERMARK_PATH=./data/logo.png
IG_SQUARE_LOGO_PATH=./data/logo_square.png
IG_FOOTER_LOGO_PATH=./data/logo_footer.png
IG_SLIDE_ICON_PATH=./data/icono_deslizar.png
IG_TITLE_FONT_PATH=./media/Montserrat-ExtraBold.ttf
IG_OVERLAY_TEMPLATE_PATH=./media/PlantillaOverlay.png
IG_WATERMARK_OPACITY=0.5
IG_WATERMARK_IMAGE_PATH=./media/logo.png
IG_WATERMARK_SCALE=0.75
IG_TITLE_COLOR=255,255,255
IG_TITLE_STROKE_WIDTH=0
IG_TITLE_BOLD_DILATE=6
IG_TITLE_SHADOW_COLOR=0,0,0
IG_TITLE_SHADOW_OFFSET=3,3
IMAGEMAGICK_BIN=magick

# LLM (relevancia por lotes + caption canonico) - utils/llm_client.py
# Consumo real por llamada en la tabla llm_usage: python -m cli.main llm-usage --hours 24
# LLM_PROVIDER: gemini (default) | openai (rollback con las variables OPENAI_*)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# minimal|low|medium|high. Los tokens de razonamiento cuentan dentro de maxOutputTokens.
GEMINI_THINKING_LEVEL=minimal
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=2048
# Solo con LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1/responses
# Optional: custom system prompt for captions
IG_CAPTION_SYSTEM_PROMPT=
OPENAI_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# TikTok + sanitizer
TIKTOK_ENABLE=1
TIKTOK_PROFILE_DIR=./data/tiktok_profile
TIKTOK_STORAGE_STATE=./data/tiktok_storage_state.json
TIKTOK_HEADLESS=0
TIKTOK_UPLOAD_URL=https://www.tiktok.com/upload
TIKTOK_PUBLISH_TIMEOUT_SEC=180
TIKTOK_MAX_RETRIES=3
SANITIZER_FRAME_SAMPLES=20
SANITIZER_SAMPLE_FPS=1
SANITIZER_MAX_MASK_AREA=0.35

# Deduplicacion semantica
DEDUP_INDEX_PATH=./data/dedup_index.faiss
DEDUP_META_PATH=./data/dedup_meta.json
DEDUP_THRESHOLD=0.88
DEDUP_SATURATION_THRESHOLD=0.80
DEDUP_SATURATION_LIMIT=3
DEDUP_WINDOW_HOURS=48
DEDUP_LOCAL_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Video processing (9:16)
IG_VIDEO_PROCESS=1
IG_VIDEO_TEMPLATE_PATH=./video_app/assets/templates/hola_salta.json
IG_VIDEO_SUBTITLES=0
IG_VIDEO_QUALITY=normal
IG_VIDEO_BLUR_SIGMA=45
IG_VIDEO_TITLE_FONT_SIZE=112
IG_VIDEO_TITLE_MAX_WIDTH_RATIO=0.82
IG_VIDEO_TITLE_MAX_HEIGHT_RATIO=0.25
IG_VIDEO_TITLE_FONT_PATH=./media/Montserrat-ExtraBold.ttf
IG_VIDEO_TITLE_PADDING_X=80
IG_VIDEO_TITLE_BOTTOM_MARGIN=320
IG_VIDEO_OUTPUT_MODE=reel
IG_VIDEO_LONG_THRESHOLD_SECONDS=120
IG_VIDEO_RAW_THRESHOLD_SECONDS=150
IG_VIDEO_REEL_THRESHOLD_SECONDS=120
IG_VIDEO_OUTPUT_DIR=./data/instagram_videos
IG_VIDEO_PROGRESS=1
FFMPEG_BIN=ffmpeg
FFMPEG_PROBE_BIN=ffprobe
FFMPEG_VCODEC=libx264
FFMPEG_PRESET=veryfast
FFMPEG_CRF=23

# Limpieza previa UI
DUO_CLEANUP=1
DUO_INTERVAL_SECONDS=3600
DUO_MAX_NOTICIAS=
DUO_DB_PATH=./data/duo_pipeline.sqlite3
DUO_TIMEZONE=America/Buenos_Aires
# Ciclo horario, cupos (6 locales, 2 nacionales, 2 Paparazzi, 2 libres), cola de 12 h, umbrales
# de relevancia y tarifas de Gemini: config/editorial_scoring.yaml. Fuentes: config/sources.yaml.
# DUO_EDITORIAL_SCORING_CONFIG=./config/editorial_scoring.yaml
# Articulos listos para la futura web (tabla web_articles). No publica nada.
DUO_WEB_PREPARE_ARTICLES=1
DUO_COMMENT_REPLY_EMOJI=🔥
DUO_COMMENT_MIN_AGE_MINUTES=10
DUO_COMMENT_MAX_AGE_MINUTES=20
DUO_ANALYTICS_DELAY_MINUTES=20
DUO_ANALYTICS_LOOKBACK_HOURS=72
DUO_ANALYTICS_CHECKPOINT_HOURS=1,6,24
DUO_BUCKET_ELITE_PERCENTILE=0.90
DUO_BUCKET_HIGH_PERCENTILE=0.70
DUO_BUCKET_MEDIUM_PERCENTILE=0.30
DUO_BUCKET_LOW_PERCENTILE=0.20
DUO_SCRAPE_DEFAULT_MAX_ITEMS_PER_SOURCE=10
DUO_SCORE_VALIDATION_DEVIATION_THRESHOLD=15
DUO_SOURCE_RANKING_LOOKBACK_DAYS=30
DUO_EDITORIAL_MASTER_PROMPT_PATH=
DUO_FORMATTED_DIR=./data/pipeline_formatted
DUO_FORMATTED_VIDEO_DIR=./data/pipeline_formatted/reels
DUO_FORMATTED_IMAGE_DIR=./data/pipeline_formatted/images
DUO_DAILY_REPORT_DIR=./data/reports
DUO_DEBUG=0
DUO_LOOP_MINUTES=60
DUO_SAFE_RECOVERY_MAX_RETRIES=3
DUO_HEARTBEAT_STALE_MINUTES=90

# Cola (Celery/Redis) - opcional
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
DUO_USE_CELERY=0

# Instagram Graph API
IG_GRAPH_VERSION=v25.0
IG_ACCESS_TOKEN=
FB_ACCESS_TOKEN=
IG_USER_ID=
IG_PAGE_ID=
FB_PAGE_ID=
IG_MEDIA_BASE_URL=
MEDIA_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=https://media.duonoticiasok.com
R2_BUCKET=duonoticiasmedia
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://media.duonoticiasok.com
R2_CUSTOM_DOMAIN=https://media.duonoticiasok.com
R2_SITE_FOLDER=img
R2_TEMP_FOLDER=img_temp
R2_DELETE_AFTER_PUBLISH=0
R2_CACHE_CONTROL=public, max-age=31536000, immutable
IG_REELS_UPLOAD_MODE=resumable
IG_REELS_THUMB_OFFSET_MS=2000
IG_RUPLOAD_RETRIES=3
IG_PUBLISH_VIDEOS=1
IG_VIDEO_AS_REEL=1
IG_PUBLISH_DUPLICATE_REELS=1
IG_NETWORK_RETRIES=5
IG_NETWORK_BACKOFF_BASE=5
IG_NETWORK_BACKOFF_MAX=120
IG_PUBLISHED_HISTORY_PATH=./data/noticias_publicadas_instagram.json

# Cloudinary legacy (fallback only when MEDIA_STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=duo_noticias
CLOUDINARY_UPLOAD_FOLDER=duo_noticias
CLOUDINARY_DELETE_AFTER_PUBLISH=1
CLOUDINARY_TIMEOUT=180
CLOUDINARY_RETRY_DOWNSCALE=1
CLOUDINARY_RETRY_MAX_SIZE_MB=30

# Runtime 24/7 nuevo
SQLITE_PATH=./data/duo_pipeline.sqlite3
OUTPUT_DIR=./data/pipeline_formatted
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# El scraping autonomo de cuentas de X se retiro (2026-10): solo se importan los links puntuales
# del intercambio de HolaSalta y los tuits incrustados en notas de medios autorizados.
ENABLE_TIKTOK=false
ENABLE_FACEBOOK=true
ENABLE_INSTAGRAM=true
ENABLE_COMMENT_ENGAGEMENT=false
ENABLE_AUTO_TUNING=false
DUO_LIVE_PUBLISH_ENABLED=false
DUO_SAFE_MODE_DEFAULT=true
WEBAPP_HOLASALTA_PATH=

# Motor audiovisual Duo Motion (motion/, ver motion/README.md). Si falta Node o
# motion/node_modules, el formateador usa el legado automaticamente.
DUO_MOTION_ENGINE=1
DUO_MOTION_NODE=node
# DUO_MOTION_DIR=./motion
DUO_MOTION_MAX_REEL_SECONDS=180
DUO_MOTION_TIMEOUT_SECONDS=300
# Copia cada pieza a motion/data/inbox para revisarla en el panel.
DUO_MOTION_INBOX=1

# Limites de Meta (cupo 24 h de IG, codigos 4/9/17/32/613, HTTP 429): espera compartida.
DUO_RATE_LIMIT_BACKOFF_MINUTES=30
DUO_RATE_LIMIT_DAILY_BACKOFF_MINUTES=180

# Meta Graph aliases soportados por la CLI nueva
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
META_PERMISSIONS=pages_show_list,business_management,instagram_basic,instagram_manage_comments,instagram_manage_insights,instagram_content_publish,instagram_manage_messages,pages_read_engagement,pages_manage_metadata,pages_read_user_content,pages_manage_posts,pages_manage_engagement,instagram_manage_contents,instagram_manage_engagement

# Links de videos de X que recolecta HolaSalta: archivo de intercambio de solo lectura
# (lo comparten HolaSalta y LVR). Estado propio en data/runtime/x_video_feed_state.json.
X_VIDEO_FEED_ENABLED=true
X_VIDEO_FEED_PATH=C:\sources\x_video_sources.json
X_VIDEO_FEED_MAX_AGE_HOURS=24
X_VIDEO_FEED_MAX_PER_CYCLE=8
# API de HolaSalta (login + GET): solo la usa el puente standalone deprecado.
HS_API_URL=
HS_API_USERNAME=
HS_API_PASSWORD=

# Entrega a la web DuoNoticias como plataforma `duo_web` del pipeline.
# DUO_WEB_MODE: disabled | ingest (POST /api/ingest/articles, docs/INGEST_CONTRACT.md)
#               | admin (POST /api/admin/articles, DUO_API.md)
# Si DUO_WEB_URL/DUO_WEB_TOKEN quedan vacios: ingest usa DUO_API_URL/DUO_API_TOKEN
# y admin usa DUO_BASE_URL/DUO_ADMIN_KEY.
ENABLE_DUO_WEB=false
DUO_WEB_MODE=disabled
DUO_WEB_URL=
DUO_WEB_TOKEN=
DUO_WEB_DEFAULT_CATEGORY=world

# Puente standalone (duonoticias_autopublicador/, deprecado): outbox propia y
# entrega a POST {DUO_API_URL}/api/ingest/articles.
POLL_INTERVAL_SECONDS=
DUO_API_URL=
DUO_API_TOKEN=
STATE_DB_PATH=
INITIAL_SYNC=
INITIAL_SYNC_LAST_N=
DRY_RUN=
SEND_MAX_ATTEMPTS=
HEARTBEAT_PATH=

# Segundo Cerebro (ver CLAUDE.md)
SEGUNDO_CEREBRO_URL=
SEGUNDO_CEREBRO_TOKEN=
SEGUNDO_CEREBRO_PROJECT_CODE=
SEGUNDO_CEREBRO_MODULE_SLUG=
